[TEMPLATE]
# ── AgentAura environment ─────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.
# Everything here can run 100% FREE — see docs/FREE_TIER.md for details.

# ── LLM (any OpenAI-compatible provider; pick ONE free option) ────────
# Option A — Groq (fast, generous free tier, no card):
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
# Option B — Google AI Studio / Gemini (free tier, no card):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-2.0-flash
# Option C — OpenRouter free models (e.g. Llama 3.3 70B free):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Option D — Cerebras (free tier, very fast):
# OPENAI_BASE_URL=https://api.cerebras.ai/v1
# OPENAI_MODEL=llama-3.3-70b
# Option E — Mistral (free "experimental" tier):
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_MODEL=mistral-small-latest
OPENAI_API_KEY=

# OKX / Onchain OS
# DEMO_MODE=true keeps all OKX activity simulated but honestly labeled.
# Set DEMO_MODE=false to use the LIVE adapters (src/lib/okx/live/). Before
# flipping, complete the human steps:
#   npx -y @okxweb3/onchainos-installer install
#   onchainos wallet login          # email OTP; key stays in the TEE
#   onchainos wallet address        # fund it at web3.okx.com/xlayer/faucet
#                                    (test OKB for gas + test USD₮0)
# Smoke-test the payment path first: node scripts/x402-smoke.mjs
DEMO_MODE=true
# Agentic Wallet (Onchain OS CLI) — requires `onchainos wallet login` interactively.
ONCHAINOS_NETWORK=xlayer-testnet
# Optional: explicit RPC for X Layer testnet if needed by the live adapter.
XLAYER_TESTNET_RPC=

# ── Live mode (DEMO_MODE=false) — see README "Live OKX mode runbook" ──
# A2MCP endpoint of the hired ASP; its 402 quote is paid via x402.
OKX_ASP_RESOURCE_URL=
# Receiving address for settlements (taken from the ASP's 402 `payTo`).
OKX_MERCHANT_PAYTO=
# Override settlement resource; defaults to OKX's mock merchant for smoke tests.
OKX_SETTLE_RESOURCE_URL=

# Optional research/search API for the Research Agent
RESEARCH_API_KEY=
