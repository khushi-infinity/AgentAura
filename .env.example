# ── AgentAura environment ─────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.
# Everything here can run 100% FREE — see docs/FREE_TIER.md for details.

# ── LLM (any OpenAI-compatible provider; pick ONE free option) ────────
# Option A — Groq (fast, generous free tier, no card):
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
# Option B — Google AI Studio / Gemini (free tier, no card):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-2.0-flash
# Option C — OpenRouter free models (e.g. Llama 3.3 70B free):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Option D — Cerebras (free tier, very fast):
# OPENAI_BASE_URL=https://api.cerebras.ai/v1
# OPENAI_MODEL=llama-3.3-70b
# Option E — Mistral (free "experimental" tier):
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_MODEL=mistral-small-latest
OPENAI_API_KEY=

# OKX / Onchain OS
# DEMO_MODE=true keeps all OKX activity simulated but honestly labeled.
DEMO_MODE=true
# Agentic Wallet (Onchain OS CLI) — requires `onchainos wallet login` interactively.
ONCHAINOS_NETWORK=xlayer-testnet
# Optional: explicit RPC for X Layer testnet if needed by the live adapter.
XLAYER_TESTNET_RPC=

# Optional research/search API for the Research Agent
RESEARCH_API_KEY=
